# generated by mb-release · Cloudflare Pages / Netlify response headers.
# Content-Security-Policy stays in index.html's <meta> tag (the app owns it); don't duplicate it here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Always revalidate the app shell so updates reach users on their next visit
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Icons and the share image change rarely; cache a week
/*.png
  Cache-Control: public, max-age=604800
/favicon.*
  Cache-Control: public, max-age=604800
